#!/bin/bash

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

git -C "$DOTFILES" submodule update --init

link() {
	src="$1"
	dest="$2"

	mkdir -p "$(dirname -- "$dest")"

	if [ -L "$dest" ]; then
		ln -sfn "$src" "$dest"
		echo "updated  $dest -> $src"
	elif [ -e "$dest" ]; then
		echo "skipped  $dest (exists and is not a symlink)" >&2
	else
		ln -s "$src" "$dest"
		echo "created  $dest -> $src"
	fi
}

link "$DOTFILES/vim"             "$HOME/.vim"
link "$DOTFILES/vim/vimrc"       "$HOME/.vimrc"

link "$DOTFILES/tmux/tmux.conf"  "$HOME/.tmux.conf"

link "$DOTFILES/zsh"             "$HOME/.zsh"
link "$DOTFILES/zsh/oh-my-zsh"   "$HOME/.oh-my-zsh"
link "$DOTFILES/zsh/zshrc"       "$HOME/.zshrc"

link "$DOTFILES/kitty/kitty.conf" "$HOME/.config/kitty/kitty.conf"
link "$DOTFILES/ghostty/config" "$HOME/.config/ghostty/config"

echo "done"
