#!/bin/bash

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

unlink() {
	dest="$1"

	[ -L "$dest" ] || return 0

	target="$(readlink "$dest")"

	case "$target" in
		/*) ;;
		*) target="$(cd "$(dirname "$dest")" && pwd)/$target" ;;
	esac

	if [ "$target" = "$DOTFILES" ] || [[ "$target" == "$DOTFILES"/* ]]; then
		rm -v -- "$dest"
	else
		echo "skipped  $dest (points to $target)" >&2
	fi
}

unlink "$HOME/.vim"
unlink "$HOME/.vimrc"

unlink "$HOME/.tmux.conf"

unlink "$HOME/.zsh"
unlink "$HOME/.oh-my-zsh"
unlink "$HOME/.zshrc"

unlink "$HOME/.Xresources"
unlink "$HOME/.config/kitty/kitty.conf"

echo "done"
